rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== DANH SÁCH EMAIL ĐƯỢC VÀO HỆ THỐNG (nhân viên) =====
    // Mỗi tài khoản trong danh sách của web app có một email trong Firebase:
    //   - NS009 (Hoàng Công Lý)  dùng email thật: hcly113@gmail.com
    //   - các tài khoản khác dùng  <mã nhân sự viết thường>@ptn.local  (ví dụ ns002@ptn.local); đuôi cũ @ptn-vlxd.vn cũng được chấp nhận
    // Phải tạo ĐỦ các người dùng này ở Firebase Console > Authentication > Users (mật khẩu do trưởng phòng đặt)
    // và TẮT cho phép tự đăng ký (Authentication > Settings > User actions > bỏ "Enable create (sign-up)").
    // Muốn bớt hoặc thêm người: sửa danh sách rồi chạy: firebase deploy --only firestore:rules
    // Nếu đổi đuôi email (domain) thì sửa cả ở public/firebase-config.js.
    function staffEmails() {
      return [
        'hcly113@gmail.com',          // NS009 Hoàng Công Lý
        'ns010@ptn.local',          // Lưu Minh Tuấn
        'ns010@ptn-vlxd.vn',
        'ns011@ptn.local',          // Nguyễn Thị Bích Lan
        'ns011@ptn-vlxd.vn',
        'ns002@ptn.local',          // Trần Đăng Hùng
        'ns002@ptn-vlxd.vn',
        'ns001@ptn.local',          // Nguyễn Văn Sự
        'ns001@ptn-vlxd.vn',
        'ns003@ptn.local',          // Nguyễn Mậu Thiện
        'ns003@ptn-vlxd.vn',
        'ns004@ptn.local',          // Trần Anh Dũng
        'ns004@ptn-vlxd.vn',
        'ns007@ptn.local',          // Lê Phước Đức
        'ns007@ptn-vlxd.vn',
        'ns008@ptn.local',          // Nguyễn Tiến Hoàng
        'ns008@ptn-vlxd.vn',
        'ns012@ptn.local',          // Hồ Thị Bích Thuỷ
        'ns012@ptn-vlxd.vn',
        'ns013@ptn.local',          // Trần Hoàn
        'ns013@ptn-vlxd.vn',
        'ns014@ptn.local',          // Phan Thanh Hà (mã tạm)
        'ns014@ptn-vlxd.vn',
        'ns015@ptn.local',          // Nguyễn Thị Cẩm Hiền (mã tạm)
        'ns015@ptn-vlxd.vn',
        'ns016@ptn.local',          // Giang Tấn Thông (mã tạm)
        'ns016@ptn-vlxd.vn',
        'ns017@ptn.local',          // Hoàng Thị Châu (mã tạm)
        'ns017@ptn-vlxd.vn',
        'ns018@ptn.local',           // Phan Thanh Giàn, Phó giám đốc (mã tạm)
        'ns018@ptn-vlxd.vn'
      ];
    }

    function signedIn() { return request.auth != null; }
    function isStaff() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email != null
        && request.auth.token.email.lower() in staffEmails();
    }
    function isAnon() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    match /{col}/{docId} {
      // Nhân viên: đọc và ghi mọi dữ liệu
      allow read, write: if isStaff();

      // Khách hàng (đăng nhập ẩn danh): chỉ GỬI yêu cầu mới ở cổng khách hàng
      allow create: if isAnon()
        && col.matches('samples.*')
        && request.resource.data.kenh == 'khach'
        && request.resource.data.status == 'cho_tiep_nhan';

      // Khách hàng ghi dòng nhật ký "Khách gửi yêu cầu"
      allow create: if isAnon() && col == 'audit';

      // Tra cứu phiếu bằng mã QR: đọc đúng một bản lưu, không liệt kê được cả bộ sưu tập
      allow get: if isAnon() && col == 'archive';
      // Cho khách chưa đăng nhập tra cứu phiếu bằng QR (trang tra cứu cần liệt kê bản lưu).
      // Mở dòng dưới là cho MỌI người có link đọc cả bộ sưu tập archive. Chỉ bật khi đã cân nhắc rủi ro lộ hồ sơ.
      // allow list: if isAnon() && col == 'archive';
    }
  }
}
